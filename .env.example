# GIRO — copie para .env e preencha.

# --- Supabase --- (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Conexão direta ao Postgres (Project Settings > Database > Connection string).
# Usada apenas pelos scripts de migration e seed, nunca pela aplicação.
SUPABASE_DB_URL=postgresql://postgres.SEU-PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres

# --- E-mail transacional (Resend) ---
RESEND_API_KEY=
EMAIL_REMETENTE="GIRO <giro@seudominio.com.br>"

# --- Aplicação ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Protege as rotas /api/cron/*. A Vercel envia este valor no header Authorization.
CRON_SECRET=
